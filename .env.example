# URL base del backend: se define en src/lib/config.ts (dev → localhost,
# producción → backend productivo). No se usa una variable VITE_* para el API.

# Clave compartida con el backend para firmar el token de reserva anónima
# (X-Client-Token). Debe coincidir con CLIENT_TOKEN_SECRET del backend.
# Generar con: openssl rand -hex 32
# VITE_CLIENT_TOKEN_SECRET=
